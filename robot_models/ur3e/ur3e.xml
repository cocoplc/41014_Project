<mujoco model="ur3e">

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ur3e">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 1 0" range="-6.28319 6.28319" armature="0.1"/>

      <default class="size1">
        <default class="size1_limited">
          <joint range="-3.14159 3.14159"/>
        </default>
      </default>

      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>

      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>

      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>


  <!-- ========================================================
       MATERIALS AND ROBOT MESHES
       ======================================================== -->

  <asset>
    <material class="ur3e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur3e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur3e" name="linkgray" rgba="0.82 0.82 0.82 1"/>
    <material class="ur3e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>


  <!-- ========================================================
       ROBOT
       ======================================================== -->

  <worldbody>

    <light name="spotlight"
           mode="targetbodycom"
           target="wrist_3_link"
           pos="0 -1 2"/>

    <!-- Raise the robot onto the stand. -->
    <body name="base" pos="0 0 0.1" childclass="ur3e">

      <inertial mass="2" pos="0 0 0"
                diaginertia="0.0030532 0.0030532 0.005625"/>

      <geom mesh="base_0" material="jointgray" class="visual"/>
      <geom mesh="base_1" material="black" class="visual"/>

      <body name="shoulder_link" pos="0 0 0.152">

        <inertial mass="2" pos="0 0 0"
                  diaginertia="0.00809316 0.00809316 0.005625"/>

        <joint name="shoulder_pan_joint" axis="0 0 1"/>

        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>

        <geom class="collision" size="0.047 0.05" pos="0 0 -0.032"/>

        <body name="upper_arm_link" pos="0 0.12 0" quat="1 0 1 0">

          <inertial mass="3.42" pos="0 0 0.122"
                    diaginertia="0.0217285 0.0217285 0.00961875"/>

          <joint name="shoulder_lift_joint"/>

          <geom mesh="upperarm_0" material="black" class="visual"/>
          <geom mesh="upperarm_1" material="urblue" class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="linkgray" class="visual"/>

          <geom class="collision"
                size="0.046 0.06"
                pos="0 -0.04 0"
                quat="1 1 0 0"/>

          <geom class="collision"
                size="0.038 0.11"
                pos="0 0 0.12"/>

          <body name="forearm_link" pos="0 -0.093 0.244">

            <inertial mass="1.26" pos="0 0 0.10625"
                      diaginertia="0.00654457 0.00654457 0.00354375"/>

            <joint name="elbow_joint" class="size1_limited"/>

            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="linkgray" class="visual"/>
            <geom mesh="forearm_2" material="black" class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>

            <geom class="collision"
                  size="0.038 0.048"
                  pos="0 0.062 0"
                  quat="1 1 0 0"/>

            <geom class="collision"
                  size="0.032 0.103"
                  pos="0 0 0.11"/>

            <body name="wrist_1_link"
                  pos="0.0005 0 0.2125"
                  quat="1 0 1 0">

              <inertial mass="0.8" pos="0 0.104 0"
                        diaginertia="0.00225 0.002085 0.002085"/>

              <joint name="wrist_1_joint"/>

              <geom mesh="wrist1_0" material="jointgray" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="black" class="visual"/>

              <geom class="collision"
                    size="0.032 0.05"
                    pos="0 0.045 0"
                    quat="1 1 0 0"/>

              <body name="wrist_2_link" pos="0 0.104 0">

                <inertial mass="0.8" pos="0 0 0.085"
                          diaginertia="0.00225 0.002085 0.002085"/>

                <joint name="wrist_2_joint" axis="0 0 1"/>

                <geom mesh="wrist2_0" material="jointgray" class="visual"/>
                <geom mesh="wrist2_1" material="black" class="visual"/>
                <geom mesh="wrist2_2" material="urblue" class="visual"/>

                <geom class="collision"
                      size="0.032 0.05"
                      pos="0 0 0.035"/>

                <geom class="collision"
                      size="0.032 0.027"
                      pos="0 0.01 0.085"
                      quat="1 1 0 0"/>

                <body name="wrist_3_link" pos="0 0 0.085">

                  <inertial mass="0.35"
                            pos="0 0.0715 0"
                            quat="1 0 0 1"
                            diaginertia="0.0001792 0.000136267 0.000136267"/>

                  <joint name="wrist_3_joint"/>

                  <geom mesh="wrist3" material="linkgray" class="visual"/>

                  <geom class="eef_collision"
                        size="0.032 0.023"
                        pos="0 0.07 0"
                        quat="1 1 0 0"/>

                  <site name="attachment_site"
                        pos="0 0.09215 0"
                        quat="-1 1 0 0"/>

                  <!-- Robotiq gripper. -->
                  <frame pos="0 0.1 0" quat="-1 1 0 0">
                    <attach model="robotiq"
                            body="base_mount"
                            prefix="gripper_"/>
                  </frame>
                  <body name="camera_mount"
                        pos="0 0.09215 0"
                        quat="-1 1 0 0">
                    <camera name="wrist_camera"
                            mode="fixed"
                            pos="0 0.065 0.10"
                            quat="0 1 0 0"
                            fovy="75"/>
                    <geom name="camera_bracket"
                          type="box"
                          pos="0 0.037 0.080"
                          size="0.005 0.019 0.003"
                          rgba="0.34 0.36 0.39 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                    <geom name="camera_housing"
                          type="box"
                          pos="0 0.065 0.080"
                          size="0.022 0.012 0.009"
                          rgba="0.13 0.14 0.16 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                    <geom name="camera_front"
                          type="box"
                          pos="0 0.065 0.090"
                          size="0.020 0.0105 0.0015"
                          rgba="0.035 0.04 0.05 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                    <geom name="camera_rgb_lens"
                          type="cylinder"
                          pos="0 0.065 0.093"
                          size="0.0045 0.0015"
                          rgba="0.05 0.12 0.19 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                    <geom name="camera_depth_left"
                          type="cylinder"
                          pos="-0.014 0.065 0.093"
                          size="0.003 0.0015"
                          rgba="0.08 0.15 0.21 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                    <geom name="camera_depth_right"
                          type="cylinder"
                          pos="0.014 0.065 0.093"
                          size="0.003 0.0015"
                          rgba="0.08 0.15 0.21 1"
                          group="2"
                          density="0"
                          contype="0"
                          conaffinity="0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>


  <!-- ========================================================
       JOINT TORQUE MOTORS
       ======================================================== -->

  <actuator>
    <motor name="shoulder_pan"
           joint="shoulder_pan_joint"
           gear="1"
           ctrlrange="-56 56"/>

    <motor name="shoulder_lift"
           joint="shoulder_lift_joint"
           gear="1"
           ctrlrange="-56 56"/>

    <motor name="elbow"
           joint="elbow_joint"
           gear="1"
           ctrlrange="-28 28"/>

    <motor name="wrist_1"
           joint="wrist_1_joint"
           gear="1"
           ctrlrange="-12 12"/>

    <motor name="wrist_2"
           joint="wrist_2_joint"
           gear="1"
           ctrlrange="-12 12"/>

    <motor name="wrist_3"
           joint="wrist_3_joint"
           gear="1"
           ctrlrange="-12 12"/>
  </actuator>


  <!-- ========================================================
       JOINT ENCODERS
       ======================================================== -->

  <sensor>
    <jointpos name="encoder_shoulder_pan_joint"
              joint="shoulder_pan_joint"/>

    <jointpos name="encoder_shoulder_lift_joint"
              joint="shoulder_lift_joint"/>

    <jointpos name="encoder_elbow_joint"
              joint="elbow_joint"/>

    <jointpos name="encoder_wrist_1_joint"
              joint="wrist_1_joint"/>

    <jointpos name="encoder_wrist_2_joint"
              joint="wrist_2_joint"/>

    <jointpos name="encoder_wrist_3_joint"
              joint="wrist_3_joint"/>
  </sensor>


  <!-- ========================================================
       INITIAL ROBOT POSE
       ======================================================== -->

  <keyframe>
    <key name="home"
         qpos="-1.83404615 -1.37708093 1.03548847 -1.22920387 -1.57079633 -0.26324982"
         ctrl="0 0 0 0 0 0"/>
  </keyframe>

</mujoco>