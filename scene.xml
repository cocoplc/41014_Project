# This is a simple scene for the UR3e robot in MuJoCo.
<mujoco model = "ur3e scene">
    <include file = "robot_models/ur3e/ur3e.xml"/>
    <compiler meshdir="robot_models/ur3e/assets"/>
    # round friction cone for the gripper fingers
    <option cone="elliptic" impratio="10"/>
# create a texture and material for the ground plane (pink and white checkerboard)
    <asset>
    # create a checkerboard texture for the ground plane
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.95 0.3 0.6" rgb2="1 1 1" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    # create a material for the ground plane using the checkerboard texture    
        <material name = "groundplane" texture = "groundplane" texrepeat = "5 5" texuniform = "true" reflectance = "0"/>
    # declare the Robotiq 2F-85 gripper model
        <model name="robotiq" file="robot_models/robotiq/2f85.xml"/>
    </asset>
# create a worldbody with a light and a floor
    <worldbody>
    # add a light source above the scene
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    # add a floor and a robot stand
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    # add a robot stand for the UR3e robot
        <geom name="robot_stand" type="cylinder" pos="0 0 0.05" size="0.1 0.05" rgba="1 0.82 0.88 1"/>
   
    # add a table in front of the robot
        <body name="table" pos="0.04 -0.29 0">
        # add a box to represent the table top and then add four cylinders to represent the table legs
           <geom name="table_top" type="box" pos="0 0 0.11" size="0.18 0.15 0.01" rgba="1 0.82 0.88 1"/>
            <geom name="leg_1" type="cylinder" pos=" 0.16  0.13 0.05" size="0.012 0.05" rgba="1 0.82 0.88 1"/>
            <geom name="leg_2" type="cylinder" pos="-0.16  0.13 0.05" size="0.012 0.05" rgba="1 0.82 0.88 1"/>
            <geom name="leg_3" type="cylinder" pos=" 0.16 -0.13 0.05" size="0.012 0.05" rgba="1 0.82 0.88 1"/>
            <geom name="leg_4" type="cylinder" pos="-0.16 -0.13 0.05" size="0.012 0.05" rgba="1 0.82 0.88 1"/>   
        </body>
            <body name="target_ball_body" pos="0.04 -0.29 0.145">
            <!-- free joint so the cube can move freely -->
            <freejoint name="target_ball_freejoint"/>
            <!-- 5 cm cube (size = half-lengths) -->
            <geom name="target_ball" type="box" size="0.025 0.025 0.025" mass="0.06" rgba="1 0.08 0.58 1"/>
        </body>
    </worldbody>
</mujoco>
