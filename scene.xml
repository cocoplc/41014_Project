# This is a simple scene for the UR3e robot in MuJoCo.
<mujoco model = "ur3e scene">
    <include file = "robot_models/ur3e/ur3e.xml"/>
    <compiler meshdir="robot_models/ur3e/assets"/>
# create a texture and material for the ground plane (pink and white checkerboard)
    <asset>
                <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.96 0.76 0.76" rgb2="1 1 1" markrgb="0.8 0.8 0.8" width="300" height="300"/>
        <material name = "groundplane" texture = "groundplane" texrepeat = "5 5" texuniform = "true" reflectance = "0"/>
    </asset>
# create a worldbody with a light and a floor
    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
